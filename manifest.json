{
  "manifest_version": 3,
  "name": "CityU Calendar Automator",
  "version": "1.2",
  "description": "Automatically export your CityU AIMS timetable to Google Calendar, Apple Calendar, or Outlook",
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "https://banweb.cityu.edu.hk/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/icon-16.png",
      "32": "images/icon-32.png",
      "48": "images/icon-48.png",
      "128": "images/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://banweb.cityu.edu.hk/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}